      "updated": 1793103218373,
      "link": null,
      "locked": false,
      "text": "-> Launch demoAppsQspiders.com\n-> Enter Name using type : keyboard   -- saranya\n-> use down method to click Control key\n-> use down method to click A\n-> up both the keys\n-> use press method to click Control+c\n-> come to email pressing Tab\n-> Enter email by pasting that you copied using press()\n-> enter remailning mail using type\n-> cometo the password field pressing tab\n-> Enter password using insertText()",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Launch demoAppsQspiders.com\n-> Enter Name using type : keyboard   -- saranya\n-> use down method to click Control key\n-> use down method to click A\n-> up both the keys\n-> use press method to click Control+c\n-> come to email pressing Tab\n-> Enter email by pasting that you copied using press()\n-> enter remailning mail using type\n-> cometo the password field pressing tab\n-> Enter password using insertText()",
      "autoResize": true,
      "lineHeight": 1.25
    },
