      "updated": 1793796449997,
      "link": null,
      "locked": false,
      "text": "class LoginPage {\n   \n   userName:Locator;\n   password:Locator;\n   logBtn:Locator;\n   page:Page\n\n  constructor(page:Page){\n    this.page:Page=page\n    this.userName : Locator= page.getByXX()\n    this.passWord: Locator=page.getByXX()\n    this.logBtn:Locator = page.getByXX()\n\n }\n\n   async login(url,UN,PW){\n     await this.page.goto(url)\n     await this.userName.fill(UN)\n     await this.passWord.fill(PW)\n     await this.logBtn.click()\n     \n   } \n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class LoginPage {\n   \n   userName:Locator;\n   password:Locator;\n   logBtn:Locator;\n   page:Page\n\n  constructor(page:Page){\n    this.page:Page=page\n    this.userName : Locator= page.getByXX()\n    this.passWord: Locator=page.getByXX()\n    this.logBtn:Locator = page.getByXX()\n\n }\n\n   async login(url,UN,PW){\n     await this.page.goto(url)\n     await this.userName.fill(UN)\n     await this.passWord.fill(PW)\n     await this.logBtn.click()\n     \n   } \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
