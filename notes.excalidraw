      "text": "-> visible   :  until the element displayed on UI\n-> hidden    :  until the element is hidden from UI\n-> attached  :  until the Dom was attached it will not consider \n-> detached  : it should be completely removed from dom",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> visible   :  until the element displayed on UI\n-> hidden    :  until the element is hidden from UI\n-> attached  :  until the Dom was attached it will not consider \n-> detached  : it should be completely removed from dom",
      "autoResize": true,
      "lineHeight": 1.25
    },
